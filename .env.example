# Citizen Grievance Portal Configuration (copy to .env and customize)

# Database (SQLite default; set postgresql+psycopg://user:pass@host:5432/dbname for PostgreSQL)
DATABASE_URL=
CGS_DB_PATH=
CGS_UPLOADS_DIR=
CGS_LOG_DIR=logs
CGS_LOG_LEVEL=INFO

# Initial Seed Passwords (leave blank in production to generate random one-time passwords printed at startup)
CGS_SEED_SUPERADMIN_PASSWORD=
CGS_SEED_ADMIN_PASSWORD=
CGS_SEED_EMPLOYEE_PASSWORD=

# Authentication & Session Hardening
CGS_LOCKOUT_MAX_ATTEMPTS=5
CGS_LOCKOUT_MINUTES=5
CGS_SESSION_TIMEOUT_MINUTES=30

# ML Classification & Review Queue
CGS_ML_CONFIDENCE_THRESHOLD=0.60
CGS_ML_ACTIVE_MODEL_DIR=ml/models

# Spam & Abuse Limits
CGS_DAILY_SUBMISSION_LIMIT=10

# Geospatial, Geocoding & Duplicate Detection
CGS_DUPLICATE_RADIUS_M=300
CGS_DUPLICATE_SIM_THRESHOLD=0.55
CGS_SUPPORT_ESCALATE_THRESHOLD_1=3
CGS_SUPPORT_ESCALATE_THRESHOLD_2=10
CGS_NOMINATIM_USER_AGENT=CitizenGrievancePortal/2.0 (local-civic-dev)

# Anomaly Detection
CGS_ANOMALY_WINDOW_HOURS=2
CGS_ANOMALY_ZSCORE=2.5

# SMTP Email Notifications (leave SMTP_HOST empty to queue locally / offline mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@civic-portal.local
SMTP_USE_TLS=true

# Public QR Status Lookup
PUBLIC_BASE_URL=http://localhost:8501
